# macOS
.DS_Store

# Claude Code (personal settings)
.claude/

# Prawduct dogfooding state (TC builds itself with Prawduct).
# Contents are ignored fail-closed; only the change-log is tracked — it feeds
# the check-change-log-entry PR gate and the release flow (#485).
.prawduct/*
!.prawduct/change-log.md

# TangleClaw project config (dogfooding artifact).
# Contents are ignored fail-closed, with ONE exception: `plans/` is tracked.
# A plan is project state, not machine state — it must survive a fresh clone and
# an engine switch, and the archiving convention explicitly leans on that ("the
# issue-state check is the contract — it protects across fresh clones, which have
# no local archive"). Ignoring plans made every clone of this repo planless.
# `.tangleclaw/*` rather than `.tangleclaw/`: git never descends into an ignored
# DIRECTORY, so a `!` negation below a bare `.tangleclaw/` would never match.
.tangleclaw/*
!.tangleclaw/plans/

# Engine configs TangleClaw GENERATES when its own clone is attached as a managed
# project (#708 — the first-run scan detects the clone and pre-selects it). These
# are machine-generated, not source, and an untracked one here is not cosmetic: it
# makes the working tree dirty, which trips `lib/update-applier.js`'s dirty-tree
# guard and blocks the self-updater. A first-time installer hit exactly that —
# TangleClaw generated `.codex.yaml` into its own clone, and the resulting dirty
# tree stranded them on the version containing the bug they were working around.
#
# CLAUDE.md is deliberately NOT listed: this repo is plugin-governed, so its
# CLAUDE.md is hand-authored and tracked (TC never regenerates it here).
.codex.yaml
.aider.conf.yml
.antigravity.md

# Internal design docs, build plans, and research notes
INTAKE-BRIEF.md
build-plan*.md
wishlist.md
todo.md
docs/methodology-extractions/

# Runtime database (generated at startup)
data/tangleclaw.db

# TLS certificates (generated locally, contain private keys)
data/certs/

# Uploads (user-specific)
.uploads/

# Screenshots (hosted in project-assets repo)
docs/screenshots/

# Node
node_modules/
__pycache__/

# Prawduct session files
.claude/settings.local.json
.prawduct/.critic-findings.json
.prawduct/.test-evidence.json
.prawduct/.pr-reviews/
.prawduct/.session-git-baseline
.prawduct/.session-handoff.md
.prawduct/.session-reflected
.prawduct/.session-start
.prawduct/.subagent-briefing.md
.prawduct/.gates-waived
.prawduct/reflections.md
.prawduct/sync-manifest.json
.prawduct/.sync-pending
.prawduct/.advisories.json

# Prawduct plugin version marker (per-repo last-seen)
.prawduct/.prawduct-version

# Prawduct session files
.prawduct/.bug-inbox
.prawduct/.critic-active
.prawduct/.critic-partials/
.prawduct/.governance-ledger.jsonl
.prawduct/.session-base-tree
.prawduct/.work-model-index.json

# Prawduct session files
.prawduct/.handoff-notes.md

# ---------------------------------------------------------------------------
# Secrets, credentials, and machine-local state.
#
# This repo is PUBLIC, and it is a product that handles TLS material, a
# basic_auth credential, and API keys — so the cost of one careless `git add -A`
# is an unrecoverable disclosure, not a revert. These are prevention rules: they
# stop a secret-bearing file from ever becoming tracked. They do NOT untrack or
# scrub anything already committed (`.gitignore` never has).
#
# `data/certs/` is already covered above; these catch the same material written
# anywhere else in the tree.
# ---------------------------------------------------------------------------

# Environment files — the standard home for tokens and API keys.
# `.env.example` is deliberately allowed: a committed template with placeholder
# values is how a contributor learns which variables exist.
.env
.env.*
!.env.example
!.env.sample

# Private keys, certificates, and keystores, wherever they land.
*.pem
*.key
*.crt
*.p12
*.pfx

# Anything self-describing as a secret.
secrets.json
secrets.*.json
*.secret
*.secrets

# Logs. Not merely noise: TangleClaw's own ingress-cutover log is known to be
# able to capture a basic_auth credential hash (#821), so an uncommitted-by-
# default posture for logs is a security property here, not tidiness.
*.log
logs/

# Engine config and local planning notes — machine state, not repo content.
# CLAUDE.md here is plugin-governed (Prawduct), hand-maintained, and duplicates
# data/global-rules.md, which IS tracked. NOTE: lib/engines.js isPluginGoverned()
# keys on .claude/settings.json, which is also ignored — so on a FRESH CLONE with
# no plugin reference, TC will generate a CLAUDE.md rather than leave it alone.
# That coupling is issue #833; revisit this line when #833 is decided.
CLAUDE.md
