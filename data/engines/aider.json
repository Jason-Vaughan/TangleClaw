{
  "id": "aider",
  "name": "Aider",
  "command": "aider",
  "interactionModel": "session",
  "configFormat": {
    "filename": ".aider.conf.yml",
    "syntax": "yaml",
    "generator": "aider-conf"
  },
  "coAuthorFormat": "Co-Authored-By: {name} <{email}>",
  "commands": [
    { "label": "Add File", "input": "/add", "description": "Add file to context" },
    { "label": "Drop File", "input": "/drop", "description": "Remove file from context" },
    { "label": "Undo", "input": "/undo", "description": "Undo last change" }
  ],
  "install": {
    "command": "python -m pip install aider-install && aider-install",
    "docsUrl": "https://aider.chat/docs/install.html"
  },
  "detection": {
    "strategy": "which",
    "target": "aider"
  },
  "launch": {
    "shellCommand": "aider",
    "args": [],
    "env": {},
    "startupDelay": 5000
  },
  "launchModes": {
    "default": { "label": "Interactive", "args": [], "description": "Confirms before each change" },
    "yesAlways": { "label": "YOLO", "args": ["--yes-always"], "description": "Auto-confirms all prompts (aider --yes-always)", "warning": "Only use in isolated environments (containers/VMs)" }
  },
  "defaultLaunchMode": "default",
  "persistent": null,
  "capabilities": {
    "launchSequence": { "supported": true },
    "supportsSlashCommands": true,
    "supportsPrimePrompt": true,
    "supportsConfigFile": true,
    "supportsCoAuthor": true,
    "conventionsCarrier": {
      "mechanism": "read-file",
      "path": ".tangleclaw/aider-conventions.md",
      "note": "TangleClaw's rules/shared-docs/PortHub/Medusa/session-memory conventions reach Aider via its own `read:` config list (a real markdown file it loads as read-only context on every session), not as `.aider.conf.yml` comments — Aider strips `#` comments before the model ever sees them (#2439). `supportsPrimePrompt` is unrelated and still governs the separate pasted startup prime."
    },
    "taskContract": {
      "supported": true,
      "module": "lib/aider-task-contract.js",
      "entryPoint": "lib/engines.js#runAiderTask",
      "invocation": "cli-one-shot",
      "note": "Bounded one-shot Aider Builder task (#1644) via Aider's own `--message-file` CLI invocation, not the interactive chat loop. No live wake idle/busy signature is configured for Aider yet (lib/medusa-wake.js) — this entry point does not depend on one."
    }
  },
  "statusPage": null
}
