{
  "id": "claude",
  "name": "Claude Code",
  "command": "claude",
  "interactionModel": "session",
  "configFormat": {
    "filename": "CLAUDE.md",
    "syntax": "markdown",
    "generator": "claude-md"
  },
  "coAuthorFormat": "Co-Authored-By: {name} <{email}>",
  "commands": [
    {
      "label": "Compact",
      "input": "/compact",
      "description": "Compress context"
    },
    {
      "label": "Clear",
      "input": "/clear",
      "description": "Clear conversation"
    },
    {
      "label": "Review",
      "input": "/review",
      "description": "Review recent changes"
    }
  ],
  "install": {
    "command": "npm install -g @anthropic-ai/claude-code",
    "docsUrl": "https://code.claude.com/docs/en/setup"
  },
  "detection": {
    "strategy": "which",
    "target": "claude"
  },
  "launch": {
    "shellCommand": "claude",
    "args": [],
    "env": {},
    "startupDelay": 2000
  },
  "launchModes": {
    "default": {
      "label": "Interactive",
      "args": [],
      "description": "Prompts for permission on every action"
    },
    "acceptEdits": {
      "label": "Accept Edits",
      "args": [
        "--permission-mode",
        "acceptEdits"
      ],
      "description": "Auto-accepts file reads and edits"
    },
    "plan": {
      "label": "Plan Only",
      "args": [
        "--permission-mode",
        "plan"
      ],
      "description": "Read-only, no code changes"
    },
    "auto": {
      "label": "Auto",
      "args": [
        "--permission-mode",
        "auto",
        "--enable-auto-mode"
      ],
      "description": "Classifier-gated: auto-approves, prompts, or refuses per rule"
    },
    "bypassPermissions": {
      "label": "Bypass",
      "args": [
        "--dangerously-skip-permissions"
      ],
      "description": "Accepts everything (containers/VMs only)",
      "warning": "Only use in isolated environments"
    }
  },
  "defaultLaunchMode": "default",
  "persistent": null,
  "capabilities": {
    "supportsSlashCommands": true,
    "supportsPrimePrompt": true,
    "supportsConfigFile": true,
    "supportsCoAuthor": true,
    "supportsSilentPrime": true,
    "startupInjection": {
      "maxChars": 10000,
      "evidence": {
        "verifiedOn": "2026-07-28",
        "source": "https://docs.claude.com/en/docs/claude-code/hooks — 10,000-char cap is per hook output; overflow REPLACES the payload with a truncation preview (probe-verified on a live install, 2026-07-28)"
      }
    },
    "readOnlyModeMarker": {
      "modeLine": "(shift+tab to cycle)",
      "marker": "plan mode on (shift+tab to cycle)",
      "label": "plan mode",
      "exit": "shift+tab",
      "evidence": {
        "verifiedOn": "2026-09-03",
        "source": "Claude Code 2.1.259, probed on a live pane: `claude --permission-mode plan` renders `⏸ plan mode on (shift+tab to cycle)` beneath the input box. `modeLine` is the signature EVERY permission mode draws — the same line reads `bypass permissions on (shift+tab to cycle)` under --dangerously-skip-permissions — so it locates the mode line; `marker` is what makes that line read-only. Locating and deciding are separate fields because a pane with subagents running draws `⏺ main` and one row per agent BELOW the mode line (live captures in test/medusa-wake.test.js, #783/#1101), so the mode line is not the last line and cannot be found by position."
      }
    }
  },
  "statusPage": {
    "adapter": "atlassian",
    "url": "https://status.claude.com/api/v2/summary.json",
    "componentId": "yyzkbfz2thpt",
    "componentName": "Claude Code"
  },
  "silentPrimeScript": "sessionstart-prime-claude.sh",
  "silentRulesScript": "sessionstart-rules-claude.sh"
}
