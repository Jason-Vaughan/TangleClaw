{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "test \"$VERCEL_GIT_COMMIT_REF\" = gh-pages",
  "git": {
    "deploymentEnabled": {
      "gh-pages": false
    }
  },
  "redirects": [
    {
      "source": "/sprint-:version.html",
      "destination": "/reports/:version/",
      "permanent": true
    }
  ]
}
