#!/usr/bin/env node
'use strict';

/**
 * tc — TangleClaw's in-pane CLI.
 *
 * A thin HTTP client over the TangleClaw API, and nothing else: no local
 * state, no config file, no store access — version skew between this script
 * and the server stays harmless because the server owns every answer. The
 * verbs live in `lib/tc-verbs.js` as a declared roster; this executable only
 * validates the environment, builds the HTTP context, and dispatches. The
 * pane environment TangleClaw injects at launch is the whole contract:
 *
 *   TANGLECLAW_API          - the API origin for this instance (required)
 *   TANGLECLAW_PROJECT_ID   - this project's numeric store id
 *   TANGLECLAW_WORKSPACE_ID - switchboard workspace id (only when minted)
 *
 * Every failure is LOUD and names what happened — a missing environment says
 * this pane was not launched under TangleClaw, an unreachable server names
 * the exact URL it tried, an API error relays the server's own words. A
 * surface that only ever describes success teaches an agent to invent one,
 * which is the failure this CLI exists to end.
 *
 * Exit codes: 0 answered (honest emptiness included) · 1 usage or
 * environment · 2 server unreachable, API error, or the action failed.
 */

const path = require('node:path');
const { VERB_ROSTER, renderUsage, receiptVerbLabel } = require(path.join(__dirname, '..', 'lib', 'tc-verbs.js'));

async function main() {
  const verb = process.argv[2];
  const argv = process.argv.slice(3);
  if (!verb || verb === '--help' || verb === '-h') {
    // Requested help is an answer (stdout, 0); a missing verb is a usage
    // error (stderr, 1).
    (verb ? process.stdout : process.stderr).write(renderUsage());
    process.exit(verb ? 0 : 1);
  }
  const entry = VERB_ROSTER.find((v) => v.id === verb);
  if (!entry) {
    process.stderr.write(`tc: unknown verb '${verb}'\n${renderUsage()}`);
    process.exit(1);
  }

  const api = process.env.TANGLECLAW_API;
  if (!api) {
    process.stderr.write(
      'tc: TANGLECLAW_API is not set — this pane was not launched under TangleClaw '
      + '(TangleClaw injects TANGLECLAW_API / TANGLECLAW_PROJECT_ID into sessions it starts). '
      + 'There is no fallback: tc cannot guess where the server is.\n'
    );
    process.exit(1);
  }
  const origin = api.replace(/\/+$/, '');

  // Provenance headers, sent on EVERY call (not authentication): the server's
  // dispatcher records one awareness receipt per invocation from these, so the
  // ledger sees every verb — including calls the M2M gate then refuses — and a
  // browser or health check can never record as the CLI.
  const headers = {
    'x-tangleclaw-cli': 'tc',
    'x-tangleclaw-verb': receiptVerbLabel(verb, argv)
  };
  if (process.env.TANGLECLAW_PROJECT_ID) headers['x-tangleclaw-project-id'] = process.env.TANGLECLAW_PROJECT_ID;
  if (process.env.TANGLECLAW_WORKSPACE_ID) headers['x-tangleclaw-workspace-id'] = process.env.TANGLECLAW_WORKSPACE_ID;
  if (process.env.TANGLECLAW_ROLE) headers['x-tangleclaw-role'] = process.env.TANGLECLAW_ROLE;

  /**
   * Perform one JSON API request; failures throw with the server's own words.
   * @param {string} method - HTTP method
   * @param {string} apiPath - Path under the API origin (leading /)
   * @param {object} [body] - JSON body for POST
   * @param {object} [opts]
   * @param {boolean} [opts.aux] - Auxiliary side-fetch (e.g. resolving the
   *   project name mid-verb): drops the verb header and marks itself so the
   *   server records ONE receipt per invocation, on the primary request only
   * @returns {Promise<object>} Parsed JSON body
   */
  async function requestJson(method, apiPath, body, opts = {}) {
    const url = `${origin}${apiPath}`;
    let reqHeaders = headers;
    if (opts.aux) {
      const { 'x-tangleclaw-verb': _dropped, ...rest } = headers;
      reqHeaders = { ...rest, 'x-tangleclaw-aux': '1' };
    }
    let res;
    try {
      res = await fetch(url, {
        method,
        signal: AbortSignal.timeout(10000),
        headers: body ? { ...reqHeaders, 'content-type': 'application/json' } : reqHeaders,
        body: body ? JSON.stringify(body) : undefined
      });
    } catch (err) {
      // Name the exact URL tried — "fetch failed" alone sends the reader
      // guessing at which of server, port, and path was wrong.
      throw new Error(`could not reach the TangleClaw API at ${url} — ${err.cause?.message || err.message}. The server may be down`);
    }
    if (!res.ok) {
      // Surface the server's error message — "unregistered peer", "gate
      // denied" — verbatim; a bare status code teaches guessing.
      let detail = '';
      try {
        const parsed = await res.json();
        if (parsed && parsed.error) detail = ` — ${parsed.error}`;
      } catch { /* non-JSON error body; the status alone will have to do */ }
      throw new Error(`the TangleClaw API answered ${res.status} for ${url}${detail}`);
    }
    return res.json();
  }

  const ctx = {
    api: origin,
    env: process.env,
    argv,
    getJson: (apiPath, opts) => requestJson('GET', apiPath, undefined, opts),
    postJson: (apiPath, body, opts) => requestJson('POST', apiPath, body, opts)
  };

  let result;
  try {
    result = await entry.run(ctx);
  } catch (err) {
    process.stderr.write(
      `tc: ${verb} failed — ${err.message}. `
      + 'Do not assume the TangleClaw capability is available or that the action happened; '
      + 'say so instead of improvising.\n'
    );
    process.exit(2);
  }
  if (result.stdout) process.stdout.write(result.stdout);
  if (result.stderr) process.stderr.write(result.stderr);
  process.exit(result.code);
}

main().catch((err) => {
  process.stderr.write(`tc: unexpected failure — ${err.message}\n`);
  process.exit(2);
});
