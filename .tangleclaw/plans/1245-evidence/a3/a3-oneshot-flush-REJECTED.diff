+/*
+ * Discard whatever the child has written that ttyd has not read (#1245).
+ *
+ * On a websocket close ttyd stops reading the pty and signals the child. On
+ * Darwin a session leader's exit waits, with no timeout, for its terminal's
+ * output queue to drain; nothing reads it any more, so the child sticks in the
+ * exiting state, holding its pty, until ttyd itself exits. Flushing the output
+ * queue from the master side (FWRITE only: the input side is left alone) leaves
+ * the exit nothing to wait for. A no-op elsewhere.
+ */
+void pty_flush_output(pty_process *process) {
+#if defined(__APPLE__)
+  if (process == NULL || process->pty < 0) return;
+  int what = FWRITE;
+  ioctl(process->pty, TIOCFLUSH, &what);
+#else
+  (void) process;
+#endif
+}
+
 bool pty_kill(pty_process *process, int sig) {
   if (process == NULL) return false;
